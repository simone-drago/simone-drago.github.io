      "html": "<button class=\"ds-btn-icon\" type=\"button\" aria-label=\"Switch to dark theme\"><svg viewBox=\"0 0 24 24\" width=\"17\" height=\"17\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z\"/></svg></button>",
      "css": ".ds-btn-icon{display:grid;place-items:center;width:2.25rem;height:2.25rem;padding:0;color:var(--ink,#101d21);background:transparent;border:1px solid var(--control,#838e90);border-radius:999px;cursor:pointer;transition:border-color .2s,background-color .2s}.ds-btn-icon:hover{border-color:var(--accent,#006967);background:var(--accent-soft,#d5f2f0)}.ds-btn-icon:focus-visible{outline:2px solid var(--accent,#006967);outline-offset:3px}"
    },
    {
      "name": "Text link",
