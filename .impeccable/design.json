  "narrative": {
    "northStar": "The Quiet Record",
    "overview": "The site is a researcher's record set quietly: the research question, the papers and their venues carry the page, and the design stays out of the way. Colour is rare and always means something, type does the ranking, and there is one moment of motion. It serves a hiring committee skimming for a few minutes as well as a reader checking every claim.",
    "keyCharacteristics": [
      "One accent, Deep Teal, with a short fixed list of jobs",
      "Near-white page with Mint Wash bands; a deep Petrol Night in dark mode",
      "Newsreader serif for names, titles and the question; Hanken Grotesk for everything else",
      "A date and label column (the spine) running down every list",
      "Flat: hairlines and tonal bands, no shadows",
      "Every link underlined; every text colour 4.5:1 or more in both themes"
    ],
    "rules": [
      {
        "name": "The Rare Teal Rule",
        "section": "colors",
        "body": "Deep Teal does six jobs only: links, the CV button, your name in author lists, award badges, the current section in the top bar, focus and selection. Labels, years, icons, dots and dividers stay ink or muted."
      },
      {
        "name": "The Underline Rule",
        "section": "colors",
        "body": "Every link is underlined. Colour never carries meaning alone."
      },
      {
        "name": "The Spine Rule",
        "section": "typography",
        "body": "Dates and paper labels sit in the left column with tabular figures; content sits in the 45rem text column to its right."
      },
      {
        "name": "The Flat Rule",
        "section": "elevation",
        "body": "No shadows for depth. Surfaces separate by tone (Mint Wash bands) and 1px hairlines."
      },
      {
        "name": "The One Moment Rule",
        "section": "motion",
        "body": "One authored animation (the research figure) plus the news ticker. Nothing else moves; reduced motion turns everything off."
      }
    ],
    "dos": [
      "Do keep Deep Teal to its six jobs",
      "Do underline every link",
      "Do keep text at 4.5:1 or more on page, band and card in both themes",
      "Do put dates and labels on the spine with tabular figures",
      "Do drive new features from fields in content/, documented in the README",
      "Do keep the two dark-theme token blocks and the theme-color tags in sync"
    ],
    "donts": [
      "Don't add glows, radial gradients or decorative backgrounds",
      "Don't use the accent on labels, years, icons, dots or other decoration",
      "Don't use shadows for depth",
      "Don't add fonts, icon fonts, CDNs or any third-party request",
      "Don't use cards for lists; rows on the spine do that job",
      "Don't add motion beyond the figure and the ticker"
    ]
  }
}